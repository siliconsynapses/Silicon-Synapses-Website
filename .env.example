# ---------------------------------------------------------------------------
# Silicon Synapses — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres) ----------------------------------------------
# Pooled connection (app runtime). From the Neon dashboard → "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct connection (migrations). From Neon → "Direct connection".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Auth.js (NextAuth v5) -------------------------------------------------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"
# Set true so Auth.js trusts the deployment host header.
AUTH_TRUST_HOST=true
# Public base URL of the site. REQUIRED in production — pass QR codes and
# confirmation emails encode absolute links built from this. Read by
# src/lib/site-url.ts (falls back to the request host, then localhost).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- First Super-Admin (used only by `npm run db:seed`) --------------------
# The seed creates ONE super-admin from these. Leave blank to skip seeding it.
SEED_SUPERADMIN_NAME="Club Admin"
SEED_SUPERADMIN_EMAIL=""
SEED_SUPERADMIN_PASSWORD=""

# --- Object storage (Cloudflare R2, S3-compatible) — optional ---------------
# Leave blank for local-disk uploads (dev). Set these in production so uploaded
# files survive deploys (Vercel's filesystem is ephemeral). Phase 6b.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public base URL for served files (R2 public bucket or custom domain).
R2_PUBLIC_BASE_URL=""

# --- Transactional email (Resend) — optional -------------------------------
# Leave blank to disable email: registration still works and shows the pass
# on-screen; no confirmation email is sent. Set both to enable sending.
RESEND_API_KEY=""
# Verified sending address, e.g. "Silicon Synapses <no-reply@yourdomain.edu>"
EMAIL_FROM=""
